# Motor HPR — gitignore
# Constitución del proyecto HPR: soberanía (S) y ejecución local (E).

# Entorno virtual local (E3) — nunca se versiona
.venv/

# IDE / editor
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Pruebas y cobertura (artefactos generados, no fuente)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov

# Sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
